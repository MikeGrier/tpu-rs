{
    "name": "tpu-mcp",
    "displayName": "tpu-mcp \u2014 encoding-safe file I/O for Copilot",
    "description": "MCP server for encoding-aware file I/O: read, write, replace, search, and validate files with correct handling of UTF-8, UTF-16LE/BE, Windows-1252, Shift-JIS, and CRLF/LF/CR line endings. Use from Copilot Chat instead of PowerShell/shell file commands to avoid encoding corruption.",
    "version": "0.1.1",
    "publisher": "MikeGrierTools",
    "license": "MIT",
    "author": {
        "name": "Michael Grier"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/MikeGrier/tpu-rs.git",
        "directory": "crates/tpu-mcp/extension"
    },
    "bugs": {
        "url": "https://github.com/MikeGrier/tpu-rs/issues"
    },
    "homepage": "https://github.com/MikeGrier/tpu-rs/tree/main/crates/tpu-mcp",
    "engines": {
        "vscode": "^1.101.0"
    },
    "categories": [
        "AI",
        "Chat",
        "Other"
    ],
    "keywords": [
        "mcp",
        "model-context-protocol",
        "copilot",
        "encoding",
        "utf-8",
        "utf-16",
        "crlf",
        "file-io",
        "ai-tools"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "mcpServerDefinitionProviders": [
            {
                "id": "tpu-mcp",
                "label": "tpu-mcp"
            }
        ],
        "commands": [
            {
                "command": "tpu-mcp.copyServerPath",
                "title": "tpu-mcp: Copy bundled server binary path",
                "category": "tpu-mcp"
            },
            {
                "command": "tpu-mcp.showServerVersion",
                "title": "tpu-mcp: Show bundled server version",
                "category": "tpu-mcp"
            }
        ],
        "configuration": {
            "title": "tpu-mcp",
            "properties": {
                "tpu-mcp.verifyDelayMs": {
                    "type": "integer",
                    "default": 100,
                    "minimum": 0,
                    "maximum": 60000,
                    "markdownDescription": "Delay in milliseconds after a write before tpu-mcp re-reads file metadata to detect Windows Defender minifilter reverts. Set to `0` once a Defender exclusion is in place to skip the verification entirely. See the README for details."
                },
                "tpu-mcp.binaryPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Override the path to the `tpu-mcp` binary. Leave blank to use the binary bundled with the extension. Intended for development against a locally-built `tpu-mcp`."
                },
                "tpu-mcp.extraArgs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "markdownDescription": "Additional command-line arguments appended to the `tpu-mcp` invocation. Intended for advanced/debug scenarios."
                }
            }
        }
    },
    "scripts": {
        "clean": "rimraf out",
        "compile": "tsc -p ./",
        "watch": "tsc -p ./ --watch",
        "vscode:prepublish": "npm run clean && npm run compile",
        "package": "vsce package",
        "package:win-x64": "vsce package --target win32-x64",
        "package:win-arm64": "vsce package --target win32-arm64"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.101.0",
        "@vscode/vsce": "^3.0.0",
        "rimraf": "^5.0.0",
        "typescript": "^5.4.0"
    }
}
